def read_bans():
    database = sqlite3.connect(f"file:{BAN_DATABASE}?mode=ro", uri=True)
    database.row_factory = sqlite3.Row
    try:
        columns = {
            row["name"]: row["type"]
            for row in database.execute("PRAGMA table_info(banned_users)")
        }
        expected = {
            "steam_id": "TEXT",
            "username": "TEXT",
            "minutes_banned": "INT",
            "timestamp": "TIMESTAMP",
        }
        if columns != expected:
            fail("SimpleAdmin 封禁数据库结构不受支持")
        rows = database.execute(
            "SELECT steam_id, username, minutes_banned, timestamp "
            "FROM banned_users ORDER BY timestamp DESC"
        ).fetchall()
        return [
            {
                "steamId": row["steam_id"],
                "playerName": row["username"],
                "minutes": row["minutes_banned"],
                "createdAt": row["timestamp"],
            }
            for row in rows
        ]
    finally:
        database.close()


def read_server_environment():
    values = {}
    seen = set()
    descriptor = os.open(CS2_ENV_FILE, os.O_RDONLY | os.O_NOFOLLOW)
    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        fail("CS2 环境配置不是普通文件")
    with os.fdopen(descriptor, encoding="utf-8") as handle:
        for number, raw in enumerate(handle, 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                fail(f"CS2 环境配置第 {number} 行无效")
            key, value = line.split("=", 1)
            key = key.strip()
            if key not in ENV_KEYS | IGNORED_ENV_KEYS or key in seen:
                fail(f"CS2 环境配置项不受支持：{key}")
            seen.add(key)
            value = value.strip()
            if (len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'"):
                value = value[1:-1]
            if "\x00" in value or "\n" in value or "\r" in value:
                fail(f"CS2 环境配置项无效：{key}")
            if key in IGNORED_ENV_KEYS:
                continue
            values[key] = value
    missing = sorted(key for key in REQUIRED_ENV if not values.get(key))
    if missing:
        fail("CS2 环境配置缺少：" + ", ".join(missing))
    for key in ("PORT", "TICKRATE", "MAXPLAYERS"):
        if not values[key].isdigit() or int(values[key]) <= 0:
            fail(f"CS2 环境配置项必须是正整数：{key}")
    if values["LAN"] not in ("0", "1"):
        fail("CS2 环境配置项 LAN 必须是 0 或 1")
    if not re.fullmatch(r"[a-zA-Z0-9_.-]+\.cfg", values["EXEC"]):
        fail("CS2 环境配置项 EXEC 无效")
    return values


def find_cs2_process():
    try:
        steam_uid = __import__("pwd").getpwnam(STEAM_USER).pw_uid
    except KeyError:
        return None
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        process = os.path.join("/proc", name)
        try:
            if os.stat(process).st_uid != steam_uid:
                continue
            with open(os.path.join(process, "comm"), encoding="ascii") as handle:
                if handle.read().strip() != "cs2":
                    continue
            with open(os.path.join(process, "cmdline"), "rb") as handle:
                command = handle.read().split(b"\0", 1)[0].decode("utf-8", "replace")
            if command.endswith("/game/bin/linuxsteamrt64/cs2") or command == "./game/bin/linuxsteamrt64/cs2":
                return int(name)
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    return None


def process_started_at(pid):
    with open(f"/proc/{pid}/stat", encoding="ascii") as handle:
        start_ticks = int(handle.read().split()[21])
    with open("/proc/stat", encoding="ascii") as handle:
        boot_time = next(int(line.split()[1]) for line in handle if line.startswith("btime "))
    return boot_time + start_ticks / os.sysconf("SC_CLK_TCK")


def server_status():
    pid = find_cs2_process()
    if pid is None:
        return {"running": False, "pid": None, "startedAt": None, "uptimeSeconds": None, "management": "fixed-script"}
    started = process_started_at(pid)
    return {
        "running": True,
        "pid": pid,
        "startedAt": datetime.datetime.fromtimestamp(started, datetime.UTC).isoformat(),
        "uptimeSeconds": max(0, int(time.time() - started)),
        "management": "fixed-script",
    }


def redact_log_line(line):
    return LOG_SECRET.sub(lambda match: f"{match.group('name')}{match.group('separator')}[REDACTED]", line)


def read_server_logs(limit=500):
    descriptor = os.open(CS2_LOG_FILE, os.O_RDONLY | os.O_NOFOLLOW)
    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        fail("CS2 日志不是普通文件")
    with os.fdopen(descriptor, encoding="utf-8", errors="replace") as handle:
        lines = deque(handle, maxlen=limit)
    return [redact_log_line(line.rstrip("\r\n"))[:4000] for line in lines]


def cfg_hash(content):
    return hashlib.sha256(content.encode("utf-8")).hexdigest()


def validate_cfg_content(content):
    if not isinstance(content, str):
        fail("CFG 内容必须是字符串")
    encoded = content.encode("utf-8")
    if len(encoded) > 128 * 1024:
        fail("CFG 内容超过 128 KiB 限制")
    if "\x00" in content or any(
        ord(character) < 32 and character not in "\n\r\t" for character in content
    ):
        fail("CFG 内容包含不允许的控制字符")
    if any(len(line.encode("utf-8")) > 4096 for line in content.splitlines()):
        fail("CFG 单行超过 4096 字节限制")
    return content.replace("\r\n", "\n").replace("\r", "\n")


def cfg_definition(config_id):
    if not isinstance(config_id, str) or config_id not in CFG_FILES:
        fail("CFG 配置 ID 不受支持")
    return CFG_FILES[config_id]


def safe_regular_file(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        fail("CFG 目标不是普通文件")
    return descriptor


def read_cfg_path(path):
    descriptor = safe_regular_file(path)
    with os.fdopen(descriptor, encoding="utf-8") as handle:
        return validate_cfg_content(handle.read())


def cfg_paths(config_id):
    filename = cfg_definition(config_id)["filename"]
    return (
        os.path.join(CFG_SOURCE_DIR, filename),
        os.path.join(CFG_RUNTIME_DIR, filename),
    )


def read_cfg(config_id):
    source, runtime = cfg_paths(config_id)
    path = source if os.path.exists(source) else runtime
    content = read_cfg_path(path)
    metadata = os.stat(path, follow_symlinks=False)
    return {
        "id": config_id,
        "label": cfg_definition(config_id)["label"],
        "filename": cfg_definition(config_id)["filename"],
        "content": content,
        "hash": cfg_hash(content),
        "persisted": path == source,
        "modifiedAt": datetime.datetime.fromtimestamp(metadata.st_mtime, datetime.UTC).isoformat(),
    }


def ensure_cfg_directories():
    steam = pwd.getpwnam(STEAM_USER)
    if not stat.S_ISDIR(os.lstat(CFG_RUNTIME_DIR).st_mode):
        fail("CFG 运行目录不是普通目录")
    for directory in (CFG_SOURCE_DIR, os.path.dirname(CFG_BACKUP_DIR), CFG_BACKUP_DIR):
        os.makedirs(directory, mode=0o750, exist_ok=True)
        metadata = os.lstat(directory)
        if not stat.S_ISDIR(metadata.st_mode):
            fail("CFG 管理目录不是普通目录")
        os.chmod(directory, 0o750)
    return steam.pw_uid, steam.pw_gid


def atomic_cfg_write(path, content, uid, gid):
    parent = os.path.dirname(path)
    descriptor, temporary = tempfile.mkstemp(prefix=".yacsrcon-cfg-", dir=parent)
    try:
        os.fchown(descriptor, uid, gid)
        os.fchmod(descriptor, 0o640)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            if content and not content.endswith("\n"):
                handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.lexists(path) and not stat.S_ISREG(os.lstat(path).st_mode):
            fail("CFG 目标不是普通文件")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def prune_cfg_backups(config_id, keep=CFG_BACKUP_LIMIT):
    directory = os.path.join(CFG_BACKUP_DIR, config_id)
    backups = sorted(
        (
            filename
            for filename in os.listdir(directory)
            if re.fullmatch(r"\d{8}T\d{6}\.\d{6}Z\.cfg", filename)
        ),
        reverse=True,
    )
    for filename in backups[keep:]:
        os.unlink(os.path.join(directory, filename))


def cfg_backup(config_id, content, uid, gid, retention=CFG_BACKUP_LIMIT):
    backup_id = datetime.datetime.now(datetime.UTC).strftime("%Y%m%dT%H%M%S.%fZ")
    directory = os.path.join(CFG_BACKUP_DIR, config_id)
    os.makedirs(directory, mode=0o750, exist_ok=True)
    if not stat.S_ISDIR(os.lstat(directory).st_mode):
        fail("CFG 备份目录不是普通目录")
    os.chmod(directory, 0o750)
    atomic_cfg_write(os.path.join(directory, f"{backup_id}.cfg"), content, uid, gid)
    prune_cfg_backups(config_id, retention)
    return backup_id


def apply_cfg(config_id, content, expected_hash, retention=CFG_BACKUP_LIMIT):
    content = validate_cfg_content(content)
    current = read_cfg(config_id)
    if not isinstance(expected_hash, str) or expected_hash != current["hash"]:
        fail("CFG 已被其他操作修改，请刷新后重试")
    uid, gid = ensure_cfg_directories()
    backup_id = cfg_backup(config_id, current["content"], uid, gid, retention)
    source, runtime = cfg_paths(config_id)
    originals = {}
    for path in (source, runtime):
        originals[path] = read_cfg_path(path) if os.path.exists(path) else None
    try:
        atomic_cfg_write(source, content, uid, gid)
        atomic_cfg_write(runtime, content, uid, gid)
    except Exception as write_error:
        rollback_failures = []
        for path, original in originals.items():
            try:
                if original is None:
                    if os.path.lexists(path):
                        os.unlink(path)
                else:
                    atomic_cfg_write(path, original, uid, gid)
            except Exception as rollback_error:
                rollback_failures.append(f"{path}: {rollback_error}")
        if rollback_failures:
            raise RuntimeError(
                f"CFG 写入失败且自动回滚不完整：{write_error}; "
                + "; ".join(rollback_failures)
                + f"; 备份 ID {backup_id}"
            ) from write_error
        raise RuntimeError(f"CFG 写入失败，已恢复原配置：{write_error}") from write_error
    return {
        **read_cfg(config_id),
        "history": cfg_history(config_id, retention),
        "backupId": backup_id,
    }


def cfg_history(config_id, limit=CFG_BACKUP_LIMIT):
    cfg_definition(config_id)
    directory = os.path.join(CFG_BACKUP_DIR, config_id)
    if not os.path.lexists(directory):
        return []
    if not stat.S_ISDIR(os.lstat(directory).st_mode):
        fail("CFG 备份目录不是普通目录")
    result = []
    for filename in sorted(os.listdir(directory), reverse=True)[:limit]:
        if not re.fullmatch(r"\d{8}T\d{6}\.\d{6}Z\.cfg", filename):
            continue
        path = os.path.join(directory, filename)
        content = read_cfg_path(path)
        result.append({
            "id": filename[:-4],
            "createdAt": datetime.datetime.strptime(filename[:-4], "%Y%m%dT%H%M%S.%fZ").replace(tzinfo=datetime.UTC).isoformat(),
            "size": len(content.encode("utf-8")),
            "hash": cfg_hash(content),
        })
    return result


def restore_cfg(config_id, backup_id, expected_hash, retention=CFG_BACKUP_LIMIT):
    if not isinstance(backup_id, str) or not re.fullmatch(r"\d{8}T\d{6}\.\d{6}Z", backup_id):
        fail("CFG 备份 ID 无效")
    path = os.path.join(CFG_BACKUP_DIR, config_id, f"{backup_id}.cfg")
    return apply_cfg(config_id, read_cfg_path(path), expected_hash, retention)


@contextmanager
def cfg_operation_lock():
    descriptor = os.open(CFG_LOCK_FILE, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
            fail("CFG 操作锁文件不安全")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("已有 CFG 操作正在进行")
        yield
    finally:
        os.close(descriptor)


def drop_to_steam():
    steam = pwd.getpwnam(STEAM_USER)
    if os.geteuid() == steam.pw_uid:
        return
    if os.geteuid() != 0:
        fail("CFG 操作必须由 root 或 steam 用户执行")
    os.setgroups([])
    os.setgid(steam.pw_gid)
    os.setuid(steam.pw_uid)


def cfg_retention(value):
    if not isinstance(value, int) or isinstance(value, bool) or not 5 <= value <= 200:
        fail("CFG 备份保留数量无效")
    return value


def fixed_directory_usage(directory):
    if not os.path.lexists(directory):
        return {"files": 0, "bytes": 0}
    if not stat.S_ISDIR(os.lstat(directory).st_mode):
        fail("备份目录不是普通目录")
    files = 0
    size = 0
    pending = [directory]
    while pending:
        current = pending.pop()
        for entry in os.scandir(current):
            if entry.is_symlink():
                continue
            if entry.is_dir(follow_symlinks=False):
                pending.append(entry.path)
            elif entry.is_file(follow_symlinks=False):
                files += 1
                size += entry.stat(follow_symlinks=False).st_size
            if files > 100000:
                fail("备份文件数量超过统计限制")
    return {"files": files, "bytes": size}


def storage_status():
    drop_to_steam()
    filesystem = os.statvfs(CS2_DIRECTORY)
    return {
        "filesystem": {
            "totalBytes": filesystem.f_blocks * filesystem.f_frsize,
            "freeBytes": filesystem.f_bavail * filesystem.f_frsize,
        },
        "cfgBackups": fixed_directory_usage(CFG_BACKUP_DIR),
        "adminBackups": fixed_directory_usage(BACKUP_DIR),
    }


def plugin_directories():
    drop_to_steam()
    disabled_path = os.path.join(PLUGIN_ROOT, "disabled")

    def directories(parent, skip_disabled=False):
        if not stat.S_ISDIR(os.lstat(parent).st_mode):
            fail("CounterStrikeSharp 插件目录不可用")
        return sorted(
            entry.name
            for entry in os.scandir(parent)
            if entry.is_dir(follow_symlinks=False)
            and not entry.is_symlink()
            and (not skip_disabled or entry.name != "disabled")
        )

    return {
        "active": directories(PLUGIN_ROOT, True),
        "disabled": directories(disabled_path),
    }


def validate_announcement_config(value):
    require_object(value, "公告配置")
    definitions = {
        "OnPlayerConnectMsgs": "connect",
        "OnAdminConnectMsgs": "connect",
        "OnRoundStartMsgs": "base",
        "OnCommandMsgs": "command",
        "TimerMsgs": "timer",
    }
    if any(key not in definitions for key in value):
        fail("公告配置包含不支持的消息类型")
    result = {}
    for key, kind in definitions.items():
        messages = value.get(key, [])
        if not isinstance(messages, list) or len(messages) > 200:
            fail(f"{key} 消息数量无效")
        for message in messages:
            require_object(message, f"{key} 消息")
            body = message.get("msg")
            if not isinstance(body, str) or not body or len(body) > 4000 or "\x00" in body:
                fail(f"{key} 消息正文无效")
            if "admin" in message and not isinstance(message["admin"], bool):
                fail(f"{key} 管理员选项无效")
            condition = message.get("cond")
            if condition is not None:
                require_object(condition, f"{key} 条件")
                if (
                    condition.get("flag") not in {f"CS2AB_flag_{number}" for number in range(1, 6)}
                    or condition.get("op") not in (0, 1, 2, 3)
                    or not isinstance(condition.get("value"), int)
                    or isinstance(condition.get("value"), bool)
                    or not -1000000 <= condition["value"] <= 1000000
                ):
                    fail(f"{key} 条件无效")
            if kind == "connect" and (
                "delay" in message
                and (not isinstance(message["delay"], (int, float)) or isinstance(message["delay"], bool) or not -1 <= message["delay"] <= 3600)
            ):
                fail(f"{key} 延迟无效")
            if kind == "command" and (
                not isinstance(message.get("cmd"), str)
                or not re.fullmatch(r"[a-zA-Z0-9_-]{1,32}", message["cmd"])
            ):
                fail(f"{key} 命令无效")
            if kind == "timer" and (
                not isinstance(message.get("timer"), (int, float))
                or isinstance(message.get("timer"), bool)
                or not 1 <= message["timer"] <= 86400
            ):
                fail(f"{key} 定时间隔无效")
        result[key] = messages
    return result


def plugin_config_definition(config_id):
    if not isinstance(config_id, str) or config_id not in PLUGIN_CONFIG_FILES:
        fail("插件配置 ID 不受支持")
    return PLUGIN_CONFIG_FILES[config_id]


def plugin_config_paths(config_id):
    relative = plugin_config_definition(config_id)["relative"]
    return os.path.join(PLUGIN_CUSTOM_ROOT, relative), os.path.join(PLUGIN_ROOT, relative)


def validate_plugin_config(config_id, value):
    if config_id == "announcements":
        value = validate_announcement_config(value)
    encoded = json.dumps(value, ensure_ascii=False).encode("utf-8")
    if len(encoded) > plugin_config_definition(config_id)["maximum"]:
        fail("插件配置超过大小限制")
    return value


def read_plugin_config(config_id):
    source, runtime = plugin_config_paths(config_id)
    path = source if os.path.exists(source) else runtime
    descriptor = safe_regular_file(path)
    with os.fdopen(descriptor, encoding="utf-8") as handle:
        value = validate_plugin_config(config_id, json.load(handle))
    metadata = os.stat(path, follow_symlinks=False)
    return {
        "config": value,
        "hash": cfg_hash(json.dumps(value, sort_keys=True, ensure_ascii=False)),
        "persisted": path == source,
        "modifiedAt": datetime.datetime.fromtimestamp(metadata.st_mtime, datetime.UTC).isoformat(),
    }


def ensure_plugin_config_directories(config_id):
    steam = pwd.getpwnam(STEAM_USER)
    source, runtime = plugin_config_paths(config_id)
    if not stat.S_ISREG(os.lstat(runtime).st_mode):
        fail("插件运行配置不是普通文件")
    for directory in (os.path.dirname(source), PLUGIN_BACKUP_ROOT, os.path.join(PLUGIN_BACKUP_ROOT, config_id)):
        os.makedirs(directory, mode=0o750, exist_ok=True)
        if not stat.S_ISDIR(os.lstat(directory).st_mode):
            fail("插件配置目录不是普通目录")
        os.chown(directory, steam.pw_uid, steam.pw_gid)
        os.chmod(directory, 0o750)
    return steam.pw_uid, steam.pw_gid


def atomic_json_write(path, value, uid, gid):
    parent = os.path.dirname(path)
    descriptor, temporary = tempfile.mkstemp(prefix=".yacsrcon-plugin-", dir=parent)
    try:
        os.fchown(descriptor, uid, gid)
        os.fchmod(descriptor, 0o640)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.lexists(path) and not stat.S_ISREG(os.lstat(path).st_mode):
            fail("插件配置目标不是普通文件")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


@contextmanager
def plugin_config_lock():
    descriptor = os.open(PLUGIN_CONFIG_LOCK_FILE, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
            fail("插件配置锁文件不安全")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("已有插件配置操作正在进行")
        yield
    finally:
        os.close(descriptor)


def write_plugin_config(config_id, value, expected_hash):
    value = validate_plugin_config(config_id, value)
    current = read_plugin_config(config_id)
    if not isinstance(expected_hash, str) or expected_hash != current["hash"]:
        fail("插件配置已被其他操作修改，请刷新后重试")
    uid, gid = ensure_plugin_config_directories(config_id)
    source, runtime = plugin_config_paths(config_id)
    backup_id = datetime.datetime.now(datetime.UTC).strftime("%Y%m%dT%H%M%S.%fZ")
    backup = os.path.join(PLUGIN_BACKUP_ROOT, config_id, f"{backup_id}.json")
    atomic_json_write(backup, current["config"], uid, gid)
    original_source = None
    original_runtime = None
    if os.path.exists(source):
        with os.fdopen(safe_regular_file(source), encoding="utf-8") as handle:
            original_source = json.load(handle)
    if os.path.exists(runtime):
        with os.fdopen(safe_regular_file(runtime), encoding="utf-8") as handle:
            original_runtime = json.load(handle)
    try:
        atomic_json_write(source, value, uid, gid)
        atomic_json_write(runtime, value, uid, gid)
    except Exception as write_error:
        rollback_failures = []
        for path, original in ((source, original_source), (runtime, original_runtime)):
            try:
                if original is None:
                    if os.path.lexists(path):
                        os.unlink(path)
                else:
                    atomic_json_write(path, original, uid, gid)
            except Exception as rollback_error:
                rollback_failures.append(f"{path}: {rollback_error}")
        if rollback_failures:
            raise RuntimeError(
                f"插件配置写入失败且自动回滚不完整：{write_error}; "
                + "; ".join(rollback_failures)
                + f"; 备份 ID {backup_id}"
            ) from write_error
        raise RuntimeError(f"插件配置写入失败，已恢复原配置：{write_error}") from write_error
    backups = sorted(
        (
            filename
            for filename in os.listdir(os.path.dirname(backup))
            if re.fullmatch(r"\d{8}T\d{6}\.\d{6}Z\.json", filename)
        ),
        reverse=True,
    )
    for filename in backups[50:]:
        os.unlink(os.path.join(os.path.dirname(backup), filename))
    return {**read_plugin_config(config_id), "backupId": backup_id}


def plugin_config_operation(value):
    require_object(value, "插件配置操作")
    config_id = value.get("id")
    operation = value.get("operation")
    if operation == "read":
        drop_to_steam()
        return read_plugin_config(config_id)
    if operation != "write":
        fail("插件配置操作不受支持")
    with plugin_config_lock():
        drop_to_steam()
        return write_plugin_config(config_id, value.get("config"), value.get("expectedHash"))


def cfg_operation(value):
    require_object(value, "CFG 操作")
    operation = value.get("operation")
    config_id = value.get("id")
    retention = cfg_retention(value.get("retention", CFG_BACKUP_LIMIT))
    if operation == "list":
        drop_to_steam()
        return [{key: item[key] for key in ("id", "label", "filename", "hash", "persisted", "modifiedAt")} for item in (read_cfg(key) for key in CFG_FILES)]
    if operation == "read":
        drop_to_steam()
        return {**read_cfg(config_id), "history": cfg_history(config_id, retention)}
    if operation not in ("write", "restore"):
        fail("CFG 操作不受支持")
    with cfg_operation_lock():
        drop_to_steam()
        if operation == "write":
            return apply_cfg(config_id, value.get("content"), value.get("expectedHash"), retention)
        return restore_cfg(config_id, value.get("backupId"), value.get("expectedHash"), retention)


def start_server():
    if find_cs2_process() is not None:
        fail("CS2 服务器已经在运行")
    values = read_server_environment()
    for executable in (RUNUSER, CS2_RUNTIME, CS2_BINARY):
        if not os.path.isfile(executable) or not os.access(executable, os.X_OK):
            fail(f"CS2 启动文件不可用：{executable}")
    command = [
        RUNUSER, "-u", STEAM_USER, "--preserve-environment", "--",
        CS2_RUNTIME, "./game/bin/linuxsteamrt64/cs2", "--graphics-provider", "", "--",
        "-dedicated", "-console", "-usercon",
        "-disable_workshop_command_filtering", "-autoupdate", "-tickrate", values["TICKRATE"],
    ]
    if values.get("IP"):
        command.extend(["-ip", values["IP"]])
    command.extend([
        "-port", values["PORT"], "+map", "de_dust2", "+sv_visiblemaxplayers", values["MAXPLAYERS"],
        "-authkey", values["API_KEY"], "+sv_setsteamaccount", values["STEAM_ACCOUNT"],
        "+game_type", "0", "+game_mode", "0", "+mapgroup", "mg_active", "+sv_lan", values["LAN"],
        "+sv_password", values.get("SERVER_PASSWORD", ""), "+rcon_password", values.get("RCON_PASSWORD", ""),
        "+exec", values["EXEC"],
    ])
    environment = {
        **values,
        "HOME": "/home/steam",
        "USER": STEAM_USER,
        "LOGNAME": STEAM_USER,
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": "C.UTF-8",
    }
    log_descriptor = os.open(
        CS2_LOG_FILE,
        os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK,
        0o600,
    )
    if not stat.S_ISREG(os.fstat(log_descriptor).st_mode):
        os.close(log_descriptor)
        fail("CS2 日志不是普通文件")
    with os.fdopen(log_descriptor, "ab", buffering=0) as log:
        process = subprocess.Popen(
            command, cwd=CS2_DIRECTORY, env=environment, stdin=subprocess.DEVNULL,
            stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
        )
    pid_descriptor = os.open(
        CS2_PID_FILE,
        os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW,
        0o600,
    )
    if not stat.S_ISREG(os.fstat(pid_descriptor).st_mode):
        os.close(pid_descriptor)
        fail("CS2 PID 文件不是普通文件")
    with os.fdopen(pid_descriptor, "w", encoding="ascii") as handle:
        handle.write(f"{process.pid}\n")
    os.chmod(CS2_PID_FILE, 0o600)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        status = server_status()
        if status["running"]:
            return status
        if process.poll() is not None:
            fail("CS2 启动进程提前退出，请查看服务器日志")
        time.sleep(0.2)
    fail("CS2 启动后未在超时时间内检测到服务器进程")


def stop_server(timeout=15):
    pid = find_cs2_process()
    if pid is None:
        fail("CS2 服务器当前未运行")
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if find_cs2_process() is None:
            return server_status()
        time.sleep(0.2)
    fail("CS2 服务器未在超时时间内停止")


@contextmanager
def server_operation_lock():
    descriptor = os.open(
        SERVER_LOCK_FILE,
        os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
    )
    try:
        lock = os.fstat(descriptor)
        if not stat.S_ISREG(lock.st_mode) or lock.st_uid != os.geteuid():
            fail("CS2 操作锁文件不安全")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("已有 CS2 服务器操作正在进行")
        yield
    finally:
        os.close(descriptor)


def control_server(action):
    with server_operation_lock():
        if action == "server-start":
            return start_server()
        if action == "server-stop":
            return stop_server()
        if action == "server-restart":
            if find_cs2_process() is not None:
                stop_server()
            return start_server()
        fail("不支持的服务器操作")


def stage_json(filename, value):
    target = os.path.join(CONFIG_DIR, filename)
    owner = os.stat(target)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{filename}.yacsrcon-", dir=CONFIG_DIR)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chown(temporary, owner.st_uid, owner.st_gid)
        os.chmod(temporary, 0o640)
        return temporary
    except Exception:
        if os.path.exists(temporary):
            os.unlink(temporary)
        raise


def restore_backup(backup):
    failures = []
    for filename in FILES.values():
        target = os.path.join(CONFIG_DIR, filename)
        owner = os.stat(target)
        descriptor, temporary = tempfile.mkstemp(prefix=f".{filename}.rollback-", dir=CONFIG_DIR)
        os.close(descriptor)
        try:
            shutil.copyfile(os.path.join(backup, filename), temporary)
            os.chown(temporary, owner.st_uid, owner.st_gid)
            os.chmod(temporary, 0o640)
            os.replace(temporary, target)
        except Exception as error:
            failures.append(f"{filename}: {error}")
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    if failures:
        raise RuntimeError("回滚不完整：" + "; ".join(failures))


def apply_config(data):
    owner = os.stat(CONFIG_DIR)
    timestamp = datetime.datetime.now(datetime.UTC).isoformat().replace(":", "-").replace(".", "-")
    backup = os.path.join(BACKUP_DIR, timestamp)
    os.makedirs(backup, mode=0o750)
    for directory in (os.path.dirname(BACKUP_DIR), BACKUP_DIR, backup):
        os.chown(directory, owner.st_uid, owner.st_gid)
    for filename in FILES.values():
        source = os.path.join(CONFIG_DIR, filename)
        destination = os.path.join(backup, filename)
        shutil.copy2(source, destination)
        os.chown(destination, owner.st_uid, owner.st_gid)
        os.chmod(destination, 0o640)
    staged = {}
    try:
        for key, filename in FILES.items():
            staged[filename] = stage_json(filename, data[key])
        for filename in FILES.values():
            os.replace(staged[filename], os.path.join(CONFIG_DIR, filename))
            staged.pop(filename)
    except Exception as write_error:
        try:
            restore_backup(backup)
        except Exception as rollback_error:
            raise RuntimeError(
                f"写入失败且自动回滚失败：{write_error}; {rollback_error}; 备份位于 {backup}"
            ) from rollback_error
        raise RuntimeError(f"写入失败，已恢复全部配置：{write_error}") from write_error
    finally:
        for temporary in staged.values():
            if os.path.exists(temporary):
                os.unlink(temporary)
    return backup


def main():
    actions = ("read", "apply", "bans", "cfg", "plugins", "plugin-config", "storage-status", "server-status", "server-logs", "server-start", "server-stop", "server-restart")
    if len(sys.argv) != 2 or sys.argv[1] not in actions:
        fail("不支持的辅助程序操作")

    if sys.argv[1] == "read":
        print(json.dumps(read_config(), ensure_ascii=False))
    elif sys.argv[1] == "bans":
        print(json.dumps(read_bans(), ensure_ascii=False))
    elif sys.argv[1] == "cfg":
        raw = sys.stdin.buffer.read(256 * 1024 + 1)
        if len(raw) > 256 * 1024:
            fail("CFG 操作输入超过限制")
        try:
            value = json.loads(raw)
        except (json.JSONDecodeError, UnicodeDecodeError) as error:
            fail(str(error))
        print(json.dumps(cfg_operation(value), ensure_ascii=False))
    elif sys.argv[1] == "storage-status":
        print(json.dumps(storage_status(), ensure_ascii=False))
    elif sys.argv[1] == "plugins":
        print(json.dumps(plugin_directories(), ensure_ascii=False))
    elif sys.argv[1] == "plugin-config":
        raw = sys.stdin.buffer.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            fail("插件配置操作输入超过限制")
        try:
            value = json.loads(raw)
        except (json.JSONDecodeError, UnicodeDecodeError) as error:
            fail(str(error))
        print(json.dumps(plugin_config_operation(value), ensure_ascii=False))
    elif sys.argv[1] == "server-status":
        print(json.dumps(server_status(), ensure_ascii=False))
    elif sys.argv[1] == "server-logs":
        print(json.dumps({"status": server_status(), "lines": read_server_logs()}, ensure_ascii=False))
    elif sys.argv[1] in ("server-start", "server-stop", "server-restart"):
        print(json.dumps(control_server(sys.argv[1]), ensure_ascii=False))
    else:
        raw = sys.stdin.buffer.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            fail("输入超过 1 MiB 限制")
        try:
            value = validate(json.loads(raw))
        except (json.JSONDecodeError, UnicodeDecodeError) as error:
            fail(str(error))
        backup_directory = apply_config(value)
        print(json.dumps({"backupDirectory": backup_directory}))


if __name__ == "__main__":
    main()
