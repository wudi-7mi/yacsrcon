RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=replace-me
RCON_TIMEOUT_MS=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
AUTH_SECRET=replace-with-at-least-32-random-characters
SERVER_NAME=CS2 Modded Server
DATABASE_PATH=./data/yacsrcon.db
# Optional; defaults beside DATABASE_PATH as yacsrcon.sessions.json and yacsrcon.jsonl
# SESSION_PATH=./data/yacsrcon.sessions.json
# AUDIT_PATH=./data/yacsrcon.jsonl
# METRICS_PATH=./data/yacsrcon.metrics.jsonl
# ALERT_STATE_PATH=./data/yacsrcon.alerts.json
# Generic JSON Webhook; token is sent as an Authorization Bearer value
# WEBHOOK_URL=https://example.com/hooks/cs2
# WEBHOOK_TOKEN=replace-me
# WEBHOOK_TIMEOUT_MS=5000
# ALERT_DISCONNECT_SAMPLES=3
# ALERT_HIGH_LATENCY_MS=500
# ALERT_HIGH_LATENCY_SAMPLES=3
# ALERT_COOLDOWN_MINUTES=30
# Number of CFG versions retained per managed file (5-200)
# CFG_BACKUP_LIMIT=50
# Rotate the audit log at this size and retain two older files
# AUDIT_MAX_BYTES=5242880
# Docker bind-mount ownership (defaults shown)
# PUID=1000
# PGID=1000
ADMIN_HELPER_PATH=/usr/local/sbin/yacsrcon-admin-helper
